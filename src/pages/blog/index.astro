---
import BaseLayout from '@/layouts/BaseLayout.astro'; import { getCollection } from 'astro:content'; const posts=(await getCollection('posts',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()); const categories=[...new Set(posts.map(p=>p.data.category))];
---
<BaseLayout title="博客"><header class="page-hero"><div class="container"><span class="eyebrow">编辑部</span><h1>博客</h1><p>关于线路选择、客户端、隐私和网络工具的实用文章。</p><div class="filters">{categories.map(c=><span class="tag">{c}</span>)}</div></div></header><section class="section"><div class="container post-list">{posts.map(p=><a class="post-item" href={`/blog/${p.id}/`}><span class="tag">{p.data.category}</span><div><strong>{p.data.title}</strong><div class="muted">{p.data.description}</div><div>{p.data.tags.map(t=><small>#{t}　</small>)}</div></div><time>{p.data.pubDate.toLocaleDateString('zh-CN')}</time></a>)}</div></section></BaseLayout>

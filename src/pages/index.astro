---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHead from '@/components/SectionHead.astro';
import AirportCard from '@/components/AirportCard.astro';
import AirportSidebar from '@/components/AirportSidebar.astro';
import HeroVisual from '@/components/HeroVisual.astro';
import QualityAirportGuide from '@/components/QualityAirportGuide.astro';
import HomeBuyingGuide from '@/components/HomeBuyingGuide.astro';
import KnowledgeHubs from '@/components/KnowledgeHubs.astro';
import { getCollection } from 'astro:content';
const airports=(await getCollection('airports')).sort((a,b)=>a.data.rank-b.data.rank);
const description='2026 机场推荐与梯子选购指南：比较 15 家机场的月付价格、流量、IEPL/IPLC/中转线路、倍率与适用场景，帮助你按需求选择稳定机场。';
const faqs=[
  ['机场越贵就一定越稳定吗？','不一定。真正需要验证的是所在地区、宽带和常用时段下的延迟、丢包、速度波动与故障恢复。'],
  ['IEPL、IPLC 和公网中转应该怎么选？','专线通常更强调稳定与低延迟，公网中转通常更看重价格和流量性价比，最终应在自己的网络环境中测试。'],
  ['为什么不建议一开始就买年付？','机场服务存在套餐调整、线路波动和运营变化等不确定性，先用短周期验证可以降低预付风险。'],
  ['月流量应该选多少？','轻度使用可从 50–100 GB 起步，经常看视频可考虑 100–300 GB，多设备和大文件场景需要更高额度。'],
  ['一次性订阅适合什么用户？','适合使用不连续、希望流量长期有效或不想每月续费的用户，购买前需确认有效期和流量清零规则。'],
  ['机场排行榜应该怎么看？','先按预算、流量和线路筛出 2–3 家，再逐一验证常用场景，排行榜不能替代个人测试。']
];
const schema={'@context':'https://schema.org','@graph':[
  {'@type':'WebSite',name:'V2Ray机场推荐榜和梯子选购（持续更新）',url:'https://v2raytizi.com/',description},
  {'@type':'WebPage',name:'2026 机场推荐与梯子选购指南',url:'https://v2raytizi.com/',description,inLanguage:'zh-CN'},
  {'@type':'ItemList',name:'15 家机场推荐排行榜',numberOfItems:airports.length,itemListElement:airports.map(a=>({'@type':'ListItem',position:a.data.rank,name:a.data.name,url:`https://v2raytizi.com/airports/${a.id}/`}))},
  {'@type':'FAQPage',mainEntity:faqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))}
]};
---
<BaseLayout title="2026 机场推荐与梯子选购指南" description={description} schema={schema}>
  <section class="hero"><div class="hero-wide"><div class="hero-grid">
    <div class="hero-copy"><span class="eyebrow">V2RAYTIZI.COM · 持续观测</span><h1>2026机场推荐和梯子选购指南：15家机场线路、价格与稳定性对比</h1><p>整理 2026 年机场推荐名单，横向比较月付价格、流量、IEPL/IPLC/中转线路、倍率、适用场景和购买风险，帮助你更快选到适合自己的梯子机场。</p><div class="hero-actions"><a class="btn primary" href="/rankings/">查看机场排行榜 →</a><a class="btn" href="/about/">了解资料口径</a></div><div class="trust-row"><div class="trust-item"><strong>15 家</strong><span>机场资料统一展示</span></div><div class="trust-item"><strong>价格透明</strong><span>展示参考月付与对应流量</span></div><div class="trust-item"><strong>推广必标注</strong><span>联盟链接与核验状态分开呈现</span></div></div></div>
    <HeroVisual />
  </div></div></section>
  <QualityAirportGuide />
  <section class="section"><div class="home-wide"><SectionHead eyebrow="本期推荐" title="先看榜单前三名" text="价格来自公开参考资料，实际金额以服务商结算页为准。" href="/rankings/" link="查看机场排行榜 →"/><div class="home-airport-layout"><div class="grid-3">{airports.slice(0,3).map(a=><AirportCard airport={a} rank={a.data.rank}/>)}</div><AirportSidebar airports={airports}/></div></div></section>
  <HomeBuyingGuide />
  <KnowledgeHubs />
  <style>.hero-wide,.home-wide{width:min(1320px,calc(100% - 28px));margin:0 auto}.hero-grid{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(430px,.92fr);gap:48px;align-items:center}.hero-copy{min-width:0}.hero-copy h1{font-size:clamp(48px,5.3vw,76px);max-width:790px}.hero-copy .trust-row{margin-top:34px}.hero-copy .trust-item{padding:17px 18px}.home-airport-layout{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:20px;align-items:start}@media(max-width:1100px){.home-airport-layout{grid-template-columns:1fr}.home-airport-layout :global(.airport-quick-sidebar){order:2}}@media(max-width:980px){.hero-grid{grid-template-columns:1fr}.hero-copy .trust-row{grid-template-columns:repeat(3,1fr)}}@media(max-width:820px){.home-airport-layout .grid-3{grid-template-columns:1fr}.hero-copy .trust-row{grid-template-columns:1fr}}@media(max-width:620px){.hero-grid{gap:28px}.hero-copy h1{font-size:42px}}</style>
</BaseLayout>

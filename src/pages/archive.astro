---
import BaseLayout from '@/layouts/BaseLayout.astro'; import { getCollection } from 'astro:content'; const posts=(await getCollection('posts')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()); const groups=posts.reduce<Record<string, typeof posts>>((acc,p)=>{const year=String(p.data.pubDate.getFullYear());(acc[year]??=[]).push(p);return acc},{});
---
<BaseLayout title="文章归档"><header class="page-hero"><div class="container"><span class="eyebrow">Archive</span><h1>文章归档</h1><p>按发布时间浏览全部评测、教程与网络观察。</p></div></header><section class="section"><div class="container">{Object.entries(groups).reverse().map(([year,list])=><section><h2>{year}</h2><div class="post-list">{list?.map(p=><a class="post-item" href={`/blog/${p.id}/`}><time>{p.data.pubDate.toLocaleDateString('zh-CN')}</time><div><strong>{p.data.title}</strong><div class="muted">{p.data.description}</div></div><span class="tag">{p.data.category}</span></a>)}</div></section>)}</div></section></BaseLayout>

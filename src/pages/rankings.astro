---
import BaseLayout from '@/layouts/BaseLayout.astro'; import RankAirportCard from '@/components/RankAirportCard.astro'; import AdSlot from '@/components/AdSlot.astro'; import { getCollection } from 'astro:content';
const airports=(await getCollection('airports')).sort((a,b)=>a.data.rank-b.data.rank);
---
<BaseLayout title="机场排行榜" description="以横向资料卡比较机场参考价格、常规流量、线路、一次性订阅和优惠码。"><header class="page-hero"><div class="wide-container"><span class="eyebrow">15 家机场 · 横向资料卡</span><h1>机场排行榜</h1><p>每张卡片集中展示常规套餐、线路、一次性订阅、优惠码和适用场景。价格只有在指定参考榜单存在对应项目时才显示，其余统一标记待核实。</p><div class="notice">榜单包含推广链接。排名用于内容展示和初步筛选，不代表任何服务永久稳定；请优先短周期、小额试用。</div></div></header><section class="section"><div class="wide-container"><div class="rank-toolbar"><input id="card-search" type="search" placeholder="搜索机场、线路或优惠码…"><select id="card-sub"><option value="all">全部订阅类型</option><option value="支持">支持一次性订阅</option><option value="待观察">一次性订阅待观察</option></select></div><div class="ranking-layout"><div><div class="rank-list">{airports.map(a=><div id={`airport-${a.data.rank}`} class="rank-entry" data-search={`${a.data.name} ${a.data.protocols.join(' ')} ${a.data.coupon??''}`} data-sub={a.data.oneTime}><RankAirportCard airport={a}/></div>)}</div><div style="margin-top:24px"><AdSlot label="排行榜合作展示位" text="推广内容不会隐藏资料状态或覆盖购买风险提示。"/></div></div><aside class="airport-sidebar"><div class="sidebar-head"><span class="eyebrow">QUICK INDEX</span><h2>15 家机场</h2><p>点击名称快速查看对应资料卡。</p></div><nav>{airports.map(a=><a href={`#airport-${a.data.rank}`}><span>{String(a.data.rank).padStart(2,'0')}</span><div><b>{a.data.name}</b><small>{a.data.price===null?'价格待核实':`¥${a.data.price}/月起`} · {a.data.oneTime}</small></div></a>)}</nav><div class="sidebar-note"><b>目录说明</b><p>侧边栏不固定，会随着页面自然滚动。排名和价格用于初步筛选，购买前仍需查看完整说明。</p></div></aside></div></div></section><script>const search=document.querySelector<HTMLInputElement>('#card-search');const sub=document.querySelector<HTMLSelectElement>('#card-sub');function apply(){document.querySelectorAll<HTMLElement>('.rank-entry').forEach(el=>{const q=(search?.value||'').toLowerCase();const match=(el.dataset.search||'').toLowerCase().includes(q);const type=sub?.value==='all'||el.dataset.sub===sub?.value;el.style.display=match&&type?'':'none'})}search?.addEventListener('input',apply);sub?.addEventListener('change',apply);</script><style>.wide-container{width:min(1320px,calc(100% - 28px));margin:0 auto}.rank-toolbar{display:flex;gap:10px;margin-bottom:18px}.rank-toolbar input,.rank-toolbar select{background:#fff;border:1px solid var(--line);border-radius:11px;padding:12px 14px;font:inherit}.rank-toolbar input{flex:1}.ranking-layout{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:20px;align-items:start}.rank-list{display:grid;gap:17px}.airport-sidebar{background:#fff;border:1px solid var(--line);border-radius:18px;padding:19px;box-shadow:0 8px 28px rgba(15,23,42,.05)}.sidebar-head h2{font-size:24px;margin:4px 0}.sidebar-head p{font-size:12px;color:var(--muted);margin:0 0 14px}.airport-sidebar nav{display:grid}.airport-sidebar nav a{display:grid;grid-template-columns:27px 1fr;gap:9px;padding:10px 4px;border-top:1px solid var(--line);align-items:start}.airport-sidebar nav a:hover b{color:var(--brand)}.airport-sidebar nav a>span{font-size:12px;font-weight:900;color:var(--brand);padding-top:2px}.airport-sidebar b{font-size:13px}.airport-sidebar small{display:block;color:var(--muted);font-size:10px;margin-top:2px}.sidebar-note{margin-top:14px;padding:12px;background:var(--bg);border-radius:11px}.sidebar-note p{font-size:10px;color:var(--muted);margin:4px 0 0;line-height:1.7}@media(max-width:980px){.ranking-layout{grid-template-columns:1fr}.airport-sidebar{order:2}.airport-sidebar nav{grid-template-columns:1fr 1fr;column-gap:14px}}@media(max-width:600px){.rank-toolbar{flex-direction:column}.airport-sidebar nav{grid-template-columns:1fr}}</style></BaseLayout>

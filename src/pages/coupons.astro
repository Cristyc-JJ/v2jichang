---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const airports=(await getCollection('airports')).filter(a=>a.data.coupon).sort((a,b)=>a.data.rank-b.data.rank);
const faq=[
  ['优惠码在哪里输入？','通常在订单确认页的优惠券或折扣码输入框中填写，确认应付金额变化后再支付。'],
  ['为什么优惠码无效？','可能是大小写、活动期限、新用户限制、套餐限制或不能与其他活动叠加造成的。'],
  ['优惠码适用于所有套餐吗？','不一定，月付、年付、一次性流量和特价套餐可能使用不同规则。'],
  ['年付折扣值得购买吗？','建议先用短周期验证线路与晚高峰表现，不要只因折扣一次预付过多。']
];
---
<BaseLayout title="2026机场优惠码大全" description="13家机场优惠码、折扣活动、使用方法和常见问题。">
  <header class="page-hero"><div class="container"><span class="eyebrow">AIRPORT COUPON CODES</span><h1>2026机场优惠码大全</h1><p>集中展示机场排行榜对应优惠码。活动和套餐规则可能变化，最终优惠以服务商结算页面为准。</p><div class="notice">输入优惠码后请确认应付金额确实下降，再完成付款。本站推广链接可能产生佣金。</div></div></header>
  <section class="section"><div class="container"><div class="coupon-grid">{airports.map(a=><article class="card coupon-card"><span class="eyebrow">机场优惠码</span><h2>{a.data.name}</h2><div class="coupon-code"><code>{a.data.coupon}</code></div><p>{['闪电鼠','大佬云','神行加速','环球梯','榴莲云','云界线'].includes(a.data.name)?'参考七折优惠券':'优惠力度以结算页显示为准'}</p><div class="actions"><a class="btn primary" href={a.data.affiliateUrl} rel="nofollow sponsored">前往服务商</a><a class="btn" href={`/airports/${a.id}/`}>查看资料</a></div></article>)}</div><section class="faq"><span class="eyebrow">COUPON FAQ</span><h2>机场优惠码常见问题</h2>{faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section></div></section>
  <style>.coupon-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.coupon-card{display:flex;flex-direction:column;min-height:230px}.coupon-card h2{font-size:22px;margin:7px 0}.coupon-code{background:#fff7db;border:1px dashed #d7b954;border-radius:12px;padding:14px;margin:10px 0}.coupon-code code{font-size:19px;font-weight:900}.coupon-card p{color:var(--muted);flex:1}.actions{display:flex;gap:8px}.faq{margin-top:50px}.faq details{background:#fff;border:1px solid var(--line);border-radius:13px;padding:0 16px;margin:9px 0}.faq summary{cursor:pointer;font-weight:800;padding:15px 0}.faq p{color:var(--muted)}@media(max-width:900px){.coupon-grid{grid-template-columns:1fr 1fr}}@media(max-width:600px){.coupon-grid{grid-template-columns:1fr}}</style>
</BaseLayout>

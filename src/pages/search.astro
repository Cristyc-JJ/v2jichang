---
import BaseLayout from '@/layouts/BaseLayout.astro'; import { getCollection } from 'astro:content'; const posts=await getCollection('posts'); const airports=await getCollection('airports'); const items=[...posts.map(p=>({title:p.data.title,description:p.data.description,url:`/blog/${p.id}/`,meta:`${p.data.category} ${p.data.tags.join(' ')}`})),...airports.map(a=>({title:a.data.name,description:a.data.tagline,url:`/airports/${a.id}/`,meta:a.data.protocols.join(' ')}))];
---
<BaseLayout title="搜索"><header class="page-hero"><div class="container"><span class="eyebrow">Search</span><h1>站内搜索</h1><p>搜索评测、教程、协议或服务名称。</p><div class="filters"><input id="site-search" type="search" placeholder="输入关键词…" autofocus></div></div></header><section class="section"><div class="container post-list" id="results">{items.map(i=><a class="post-item search-item" data-search={`${i.title} ${i.description} ${i.meta}`} href={i.url}><span class="tag">结果</span><div><strong>{i.title}</strong><div class="muted">{i.description}</div></div><span>→</span></a>)}</div></section><script>const input=document.querySelector<HTMLInputElement>('#site-search');const items=document.querySelectorAll<HTMLElement>('.search-item');function run(){const q=(input?.value||'').trim().toLowerCase();items.forEach(i=>i.style.display=(i.dataset.search||'').toLowerCase().includes(q)?'':'none')}input?.addEventListener('input',run);const q=new URLSearchParams(location.search).get('q');if(q&&input){input.value=q;run()}</script></BaseLayout>

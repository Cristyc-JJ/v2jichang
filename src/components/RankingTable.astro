---
const { airports }=Astro.props;
---
<div class="filters"><input id="rank-search" type="search" placeholder="搜索机场、线路或订阅类型…"><select id="price-filter"><option value="all">全部价格</option><option value="15">¥15 以下</option><option value="20">¥20 以下</option><option value="30">¥30 以下</option></select><select id="sub-filter"><option value="all">全部订阅类型</option><option value="支持">支持一次性订阅</option><option value="待观察">一次性订阅待观察</option></select></div>
<div class="table-wrap desktop-table"><table><thead><tr><th>排名 / 服务</th><th>参考月付</th><th>常规流量</th><th>线路</th><th>一次性订阅</th><th>优惠码</th><th>资料状态</th><th></th></tr></thead><tbody>{airports.map((a)=><tr data-name={`${a.data.name} ${a.data.protocols.join(' ')} ${a.data.oneTime}`} data-price={a.data.price??''} data-sub={a.data.oneTime}><td><span class="rank">{String(a.data.rank).padStart(2,'0')}</span>　<strong>{a.data.name}</strong></td><td>{a.data.price===null?<strong>待核实</strong>:<><strong>¥{a.data.price}</strong>/月起</>}</td><td>{a.data.traffic}</td><td>{a.data.protocols.join(' / ')}</td><td><span class="badge">{a.data.oneTime}</span></td><td>{a.data.coupon??'—'}</td><td>{a.data.status}</td><td><a class="btn" href={`/airports/${a.id}/`}>详情</a></td></tr>)}</tbody></table></div>
<div class="mobile-cards">{airports.map((a)=><article class="rank-card" data-name={`${a.data.name} ${a.data.protocols.join(' ')} ${a.data.oneTime}`} data-price={a.data.price??''} data-sub={a.data.oneTime}><div class="rank-card-head"><span class="rank">{String(a.data.rank).padStart(2,'0')}</span><strong>{a.data.name}</strong><span class="score">{a.data.price===null?'待核实':`¥${a.data.price}`}</span></div><div class="facts"><div class="fact"><small>月流量</small>{a.data.traffic}</div><div class="fact"><small>一次性订阅</small>{a.data.oneTime}</div><div class="fact"><small>优惠码</small>{a.data.coupon??'—'}</div></div><p class="muted">{a.data.protocols.join(' / ')} · {a.data.status}</p><a class="btn primary" href={`/airports/${a.id}/`}>查看详情</a></article>)}</div>
<script>const q=document.querySelector<HTMLInputElement>('#rank-search');const p=document.querySelector<HTMLSelectElement>('#price-filter');const sub=document.querySelector<HTMLSelectElement>('#sub-filter');function filter(){document.querySelectorAll<HTMLElement>('[data-name]').forEach(el=>{const hit=(el.dataset.name||'').toLowerCase().includes((q?.value||'').toLowerCase());const raw=el.dataset.price||'';const price=p?.value==='all'||(raw!==''&&Number(raw)<=Number(p?.value));const subscription=sub?.value==='all'||el.dataset.sub===sub?.value;el.style.display=hit&&price&&subscription?'':'none'})}q?.addEventListener('input',filter);p?.addEventListener('change',filter);sub?.addEventListener('change',filter);</script>

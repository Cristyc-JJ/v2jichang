  @media(max-width:620px){.hero-visual{min-height:430px}.keyword-grid{grid-template-columns:1fr 1fr}.keyword-card:last-child{grid-column:1/-1}.visual-title b{font-size:20px}.chip-two{top:220px}.chip-three{top:275px}}
</style>

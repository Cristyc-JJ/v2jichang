<div class="hero-visual" aria-label="机场线路、价格与使用场景概览">
  <div class="visual-title">
    <small>GLOBAL ROUTE MAP</small>
    <b>线路、价格与场景一目了然</b>
  </div>

  <svg class="network-art" viewBox="0 0 560 380" role="img" aria-label="全球机场线路节点示意图">
    <defs>
      <linearGradient id="route-line" x1="0" x2="1">
        <stop stop-color="#ffffff" />
        <stop offset="1" stop-color="#8f98a6" />
      </linearGradient>
      <filter id="node-glow">
        <feGaussianBlur stdDeviation="4" result="blur" />
        <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>
    <path d="M60 220 C150 70 220 80 282 188 S430 330 510 140" fill="none" stroke="url(#route-line)" stroke-width="3" stroke-dasharray="7 8" opacity=".9" />
    <path d="M85 105 C190 210 350 20 478 225" fill="none" stroke="#c7ccd3" stroke-width="2" opacity=".55" />
    <g fill="#ffffff" filter="url(#node-glow)">
      <circle cx="60" cy="220" r="8" /><circle cx="150" cy="105" r="6" />
      <circle cx="282" cy="188" r="11" /><circle cx="400" cy="275" r="7" />
      <circle cx="510" cy="140" r="9" /><circle cx="478" cy="225" r="6" />
    </g>
    <g fill="#e5e7eb" font-size="12" font-family="Arial, sans-serif">
      <text x="35" y="247">Hong Kong</text><text x="125" y="87">Tokyo</text>
      <text x="257" y="222">Singapore</text><text x="374" y="304">Europe</text>
      <text x="482" y="122">US West</text>
    </g>
    <g transform="translate(215 115)">
      <rect width="134" height="56" rx="14" fill="#fff" opacity=".94" />
      <text x="16" y="23" fill="#0f172a" font-size="11" font-weight="700">V2Ray机场推荐榜和梯子选购（持续更新）观测节点</text>
      <text x="16" y="42" fill="#4b5563" font-size="10">15 家机场 · 持续更新</text>
    </g>
  </svg>

  <span class="floating-chip chip-one">IEPL 专线</span>
  <span class="floating-chip chip-two">一次性订阅</span>
  <span class="floating-chip chip-three">流媒体 / AI</span>

  <div class="keyword-grid">
    <div class="keyword-card"><small>常规月流量</small><b>100–130 GB</b></div>
    <div class="keyword-card"><small>重点对比</small><b>价格 · 线路 · 倍率</b></div>
    <div class="keyword-card"><small>透明标注</small><b>推广与核验状态</b></div>
  </div>
</div>

<style>
